{
  "name": "presstrack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:all": "concurrently \"vite\" \"tsx watch --env-file-if-exists=.env server/index.ts\"",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --testNamePattern=integration",
    "test:e2e": "playwright test",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@tailwindcss/vite": "^4.3.3",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mammoth": "^1.13.0",
    "mongodb": "^7.7.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
